{
  "multipart": [
    {
      "when": {
        "fuel": "0"
      },
      "apply": {
        "model": "semiconductor-lab:block/carbide_lamp"
      }
    },
    {
      "when": {
        "fuel": "1|2|3|4|5|6|7|8"
      },
      "apply": {
        "model": "semiconductor-lab:block/carbide_lamp_lit"
      }
    }
  ]
}
