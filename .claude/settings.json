{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew.bat compileJava*)",
      "Bash(./gradlew.bat compileClientJava*)",
      "Bash(./gradlew.bat build*)",
      "Bash(./gradlew.bat runGameTest*)",
      "PowerShell(./gradlew.bat compileJava*)",
      "PowerShell(./gradlew.bat compileClientJava*)",
      "PowerShell(./gradlew.bat build*)",
      "PowerShell(./gradlew.bat runGameTest*)",
      "PowerShell(.\\gradlew.bat compileJava*)",
      "PowerShell(.\\gradlew.bat compileClientJava*)",
      "PowerShell(.\\gradlew.bat build*)",
      "PowerShell(.\\gradlew.bat runGameTest*)",

      "PowerShell(./tools/test.ps1*)",
      "PowerShell(.\\tools\\test.ps1*)",
      "PowerShell(& ./tools/test.ps1*)",
      "PowerShell(& .\\tools\\test.ps1*)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File tools/test.ps1*)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File .\\tools\\test.ps1*)",
      "Bash(powershell -ExecutionPolicy Bypass -File tools/test.ps1*)",
      "Bash(powershell.exe -ExecutionPolicy Bypass -File tools/test.ps1*)",

      "Bash(python tools/*)",
      "PowerShell(python tools/*)",
      "PowerShell(python tools\\*)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git pull --rebase*)",
      "Bash(git push)",
      "Bash(git push origin master)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git pull --rebase*)",
      "PowerShell(git push)",
      "PowerShell(git push origin master)"
    ],
    "deny": [
      "Bash(git push*--force*)",
      "Bash(git push*-f *)",
      "Bash(git push*-f)",
      "Bash(git push*+*)",
      "PowerShell(git push*--force*)",
      "PowerShell(git push*-f *)",
      "PowerShell(git push*-f)",
      "PowerShell(git push*+*)",

      "Bash(git reset*--hard*)",
      "PowerShell(git reset*--hard*)",

      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf ..*)",
      "Bash(rm -rf *.git*)",
      "Bash(rm -rf C:*)",
      "Bash(rm -rf c:*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf \"$HOME*)",
      "PowerShell(Remove-Item*-Recurse*..*)",
      "PowerShell(Remove-Item*..*-Recurse*)",
      "PowerShell(Remove-Item*-Recurse*.git*)",
      "PowerShell(Remove-Item*.git*-Recurse*)",
      "PowerShell(Remove-Item*-Recurse*:\\*)",
      "PowerShell(Remove-Item*:\\*-Recurse*)",
      "PowerShell(Remove-Item*-Recurse*:/*)",
      "PowerShell(Remove-Item*:/*-Recurse*)",
      "PowerShell(Remove-Item*-Recurse*$env:*)",
      "PowerShell(Remove-Item*$env:*-Recurse*)",
      "PowerShell(Remove-Item*-Recurse*~*)",
      "PowerShell(Remove-Item*~*-Recurse*)",

      "Bash(taskkill*/IM*)",
      "Bash(taskkill*/im*)",
      "PowerShell(taskkill*/IM*)",
      "PowerShell(taskkill*/im*)",
      "PowerShell(Stop-Process*-Name*)",
      "PowerShell(Stop-Process*-name*)",

      "Bash(*runClient*)",
      "PowerShell(*runClient*)"
    ]
  }
}
